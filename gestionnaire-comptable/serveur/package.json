{
  "name": "gestionnaire-comptable-serveur",
  "version": "0.1.0",
  "private": true,
  "description": "Serveur de GESTIONNAIRE COMPTABLE : API, authentification, permissions, journal d'audit",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p .",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "demarrer": "node --env-file-if-exists=.env dist/src/index.js",
    "migrer": "node --env-file-if-exists=.env dist/src/cli/migrer.js",
    "entreprise:creer": "node --env-file-if-exists=.env dist/src/cli/creer-entreprise.js",
    "journal:verifier": "node --env-file-if-exists=.env dist/src/cli/verifier-journal.js",
    "sauvegarder": "node --env-file-if-exists=.env dist/src/cli/sauvegarder.js",
    "restaurer": "node --env-file-if-exists=.env dist/src/cli/restaurer.js",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "demo:initialiser": "node --env-file-if-exists=.env dist/src/cli/demo-initialiser.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "argon2": "^0.41.1",
    "fastify": "^5.12.7",
    "pdfkit": "^0.17.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.13.9",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.5",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "5.6"
  }
}
