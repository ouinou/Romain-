# Copier ce fichier en .env et remplacer chaque valeur. Ne jamais versionner le fichier .env.

# Connexion du serveur au quotidien (rôle gc_app : soumis à l'isolation, sans droit sur le journal).
GC_BASE_DE_DONNEES=postgres://gc_app:A-REMPLACER@localhost:5432/gestionnaire_comptable

# Connexion des outils d'exploitation (migrations, création d'entreprise, vérification du journal).
GC_BASE_PROPRIETAIRE=postgres://gc_owner:A-REMPLACER@localhost:5432/gestionnaire_comptable

# Connexion des sauvegardes (rôle gc_backup, lecture seule).
GC_BASE_SAUVEGARDE=postgres://gc_backup:A-REMPLACER@localhost:5432/gestionnaire_comptable

# Clés de 32 octets en base64. Générer chacune avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# GC_CLE_CHIFFREMENT protège les secrets de double authentification.
# GC_CLE_SAUVEGARDE chiffre les sauvegardes : en garder une copie HORS du serveur (coffre, papier sous scellé).
GC_CLE_CHIFFREMENT=
GC_CLE_SAUVEGARDE=

# Réseau local. 0.0.0.0 = accessible depuis les autres postes ; 127.0.0.1 = ce poste uniquement.
GC_HOTE=0.0.0.0
GC_PORT=8443

# HTTPS (fortement recommandé, sinon les mots de passe circulent en clair sur le réseau).
GC_TLS_CERTIFICAT=C:\GestionnaireComptable\certificats\serveur.crt
GC_TLS_CLE=C:\GestionnaireComptable\certificats\serveur.key

# Sessions et protection contre les tentatives répétées.
GC_SESSION_INACTIVITE_MINUTES=15
GC_SESSION_DUREE_MAX_HEURES=10
GC_ECHECS_AVANT_VERROUILLAGE=5
GC_VERROUILLAGE_MINUTES=15
GC_TENTATIVES_PAR_IP=30
GC_FENETRE_TENTATIVES_MINUTES=10

# Exploitation.
GC_PG_BIN=C:\Program Files\PostgreSQL\16\bin
GC_DOSSIER_SAUVEGARDES=D:\Sauvegardes\GestionnaireComptable
GC_FICHIER_ANCRAGES=D:\Sauvegardes\GestionnaireComptable\ancrages-journal.tsv
GC_JOURNAL_NIVEAU=info

# Copie complète des journaux d'audit (fichiers JSONL), sur un support distinct du serveur.
GC_DOSSIER_COPIE_JOURNAL=E:\CopieJournaux

# Validité d'une confirmation par mot de passe avant une opération sensible.
GC_CONFIRMATION_MINUTES=5
