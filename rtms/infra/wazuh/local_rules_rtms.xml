<!-- Règles locales Wazuh (gestionnaire) : /var/ossec/etc/rules/local_rules.xml -->
<group name="rtms,">
  <rule id="100500" level="5">
    <decoded_as>json</decoded_as>
    <field name="msg">erreur interne</field>
    <description>RTMS : erreur interne de l'API</description>
  </rule>
  <rule id="100510" level="10" frequency="20" timeframe="60">
    <decoded_as>json</decoded_as>
    <field name="res.statusCode">^401$|^423$</field>
    <field name="req.url">/api/auth/login</field>
    <description>RTMS : rafale d'échecs de connexion (force brute probable)</description>
    <mitre><id>T1110</id></mitre>
  </rule>
  <rule id="100520" level="12">
    <decoded_as>json</decoded_as>
    <field name="res.statusCode">^403$</field>
    <field name="req.url">/api/admin</field>
    <description>RTMS : tentative d'accès à l'administration refusée</description>
  </rule>
</group>
