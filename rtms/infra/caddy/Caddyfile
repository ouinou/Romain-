# Terminaison TLS devant l'API. Le domaine public passe par Cloudflare (proxy orange).
# Certificat : « Cloudflare Origin Certificate » + Authenticated Origin Pulls (mTLS) :
# seul Cloudflare peut joindre l'origine, ce qui empêche de contourner le WAF.
{
	email admin@{$RTMS_DOMAIN}
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
		client_ip_headers CF-Connecting-IP
	}
}

{$RTMS_DOMAIN} {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key {
		protocols tls1.2 tls1.3
		client_auth {
			mode require_and_verify
			trusted_ca_cert_file /etc/caddy/certs/cloudflare-aop-ca.pem
		}
	}
	encode zstd gzip
	request_body { max_size 12MB }
	# /metrics n'est jamais exposé publiquement
	@metrics path /metrics*
	respond @metrics 404
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		-Server
	}
	reverse_proxy api:3000 {
		lb_policy least_conn
		health_uri /healthz
		health_interval 10s
	}
	log {
		output stdout
		format json
	}
}
