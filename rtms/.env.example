# Copier en .env (jamais commité). En production, préférer Vault ou des fichiers *_FILE.
POSTGRES_PASSWORD=change-me
RTMS_OWNER_PASSWORD=change-me
RTMS_APP_PASSWORD=change-me
RTMS_LICENSE_PASSWORD=change-me
REDIS_PASSWORD=change-me
# 32 octets en base64 : openssl rand -base64 32
DATA_ENCRYPTION_KEYS=v1:REMPLACER
METRICS_TOKEN=change-me
PUBLIC_ORIGIN=https://rtms.example.td
RTMS_DOMAIN=rtms.example.td
LICENSE_ENFORCEMENT=enforce
LICENSE_ISSUER_URL=https://licences.example.com
# Clé PUBLIQUE uniquement (la privée reste sur le serveur de l'éditeur)
LICENSE_PUBLIC_KEY_PEM=
SENTRY_DSN=
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=/run/secrets/restic_password
GRAFANA_ADMIN_PASSWORD=change-me
